// Renovate for astrona-cli — run by Mend's hosted Renovate GitHub App
// (installed on the astrona-io org; https://developer.mend.io shows its
// jobs and logs). Its PRs trigger CI like any other PR.
//
// Auto-merge: Go module minor/patch updates are handed to GitHub's native
// auto-merge, which merges only once the required checks on main (Lint,
// Unit tests, E2E) pass. Major updates, the Go toolchain and GitHub
// Actions updates stay manual.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  labels: ['dependencies'],
  // Supply-chain safety: wait a few days after a release (yanked or
  // malicious versions are usually caught by then), and don't open PRs
  // for releases still inside that window.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  platformAutomerge: true,
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  packageRules: [
    {
      description: 'Ensure Go updates are compatible with the Go version defined in go.mod',
      matchManagers: ['gomod'],
      constraintsFiltering: 'strict',
    },
    {
      description: 'Group golang.org/x packages to reduce PR noise',
      matchManagers: ['gomod'],
      matchPackageNames: ['/^golang\\.org\\/x\\//'],
      groupName: 'golang.org/x packages',
    },
    {
      description: 'Auto-merge Go module minor/patch/digest updates once CI passes',
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
      automergeType: 'pr',
    },
    {
      description: 'Never auto-merge the go / toolchain directive — needs a human to check CI images and docs',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang', 'toolchain'],
      automerge: false,
    },
  ],
}
