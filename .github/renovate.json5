// Renovate for astrona-cli — run by Mend's hosted Renovate GitHub App
// (installed on the astrona-io org; https://developer.mend.io shows its
// jobs and logs). Its PRs trigger CI like any other PR.
//
// Renovate merges dependency PRs into main after checks pass. It performs
// the merge itself, without relying on GitHub's native auto-merge setting.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  labels: ['dependencies'],
  // Supply-chain safety: wait a few days after a release (yanked or
  // malicious versions are usually caught by then), and don't open PRs
  // for releases still inside that window.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  baseBranchPatterns: ['main'],
  automerge: true,
  automergeType: 'pr',
  platformAutomerge: false,
  ignoreTests: false,
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
  packageRules: [
    {
      description: 'Ensure Go updates are compatible with the Go version defined in go.mod',
      matchManagers: ['gomod'],
      constraintsFiltering: 'strict',
    },
    {
      description: 'Group golang.org/x packages to reduce PR noise',
      matchManagers: ['gomod'],
      matchPackageNames: ['/^golang\\.org\\/x\\//'],
      groupName: 'golang.org/x packages',
    },
  ],
}
