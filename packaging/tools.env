# Versions are updated deliberately; never resolve "latest" during a build.
# The Linux package build and `astrona setup` both install these versions and
# verify them against the SHA-256 checksums below. Bump a version together
# with its checksums, copied from the project's own release checksum files:
#   kind:    https://github.com/kubernetes-sigs/kind/releases/download/<KIND_VERSION>/kind-linux-<arch>.sha256sum
#   kubectl: https://dl.k8s.io/release/<KUBECTL_VERSION>/bin/linux/<arch>/kubectl.sha256
KIND_VERSION=v0.33.0
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_LINUX_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256_LINUX_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
KUBECTL_SHA256_LINUX_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
ORAS_VERSION=1.3.4
