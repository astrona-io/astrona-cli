    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vue-tsc": "3.3.14"
  }
}
