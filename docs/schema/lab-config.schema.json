    "BootstrapConfig": {
      "additionalProperties": false,
      "properties": {
        "init": {
          "items": {
            "$ref": "#/$defs/ResourceItem"
          },
          "type": "array"
        },
        "manifests": {
          "items": {
            "$ref": "#/$defs/ResourceItem"
          },
          "type": "array"
        },
        "waitFor": {
          "items": {
            "$ref": "#/$defs/WaitFor"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DocsConfig": {
      "additionalProperties": false,
      "properties": {
        "caseStudy": {
          "type": "string"
        },
        "examQuestion": {
          "type": "string"
        },
        "guide": {
          "type": "string"
        },
        "prerequisites": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ExamConfig": {
      "additionalProperties": false,
      "properties": {
        "hideHints": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        },
        "timeLimit": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "GatewayPorts": {
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": "integer"
        },
        "https": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "KindAddons": {
      "additionalProperties": false,
      "properties": {
        "certManager": {
          "type": "boolean"
        },
        "cni": {
