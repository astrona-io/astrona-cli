        "bootstrap": {
          "$ref": "#/$defs/BootstrapConfig"
        },
        "dependsOn": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "featureGates": {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        "image": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "networking": {
          "$ref": "#/$defs/KindNetworking"
        },
        "nodes": {
          "$ref": "#/$defs/KindNodes"
        },
        "preloadImages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtimeConfig": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "teardown": {
          "$ref": "#/$defs/KindLabTeardown"
        },
        "testing": {
          "$ref": "#/$defs/BootstrapConfig"
        },
        "version": {
          "type": "string"
        },
        "wan": {
          "$ref": "#/$defs/WANConditions"
        }
      },
      "type": "object"
