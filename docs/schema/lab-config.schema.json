      "additionalProperties": false,
      "properties": {
        "docs": {
          "$ref": "#/$defs/DocsConfig"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "PortForward": {
      "additionalProperties": false,
