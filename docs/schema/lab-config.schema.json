        "loss": {
          "type": "string"
        },
        "rate": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "WaitFor": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "boolean"
        },
        "condition": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://cli.astrona.io/schema/lab-config.schema.json",
  "$ref": "#/$defs/LabConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astrona lab config (config.yaml)"
}
