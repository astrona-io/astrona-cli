        "serial": {
          "type": "string"
        },
        "sizeGB": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "QEMUImageSource": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "type": "string"
