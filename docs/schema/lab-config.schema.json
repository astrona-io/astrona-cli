          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "contains": {
          "type": "string"
        },
        "expect": {
          "type": "string"
        },
        "expectRegex": {
          "type": "string"
        },
        "expectStatus": {
          "type": "integer"
        },
        "hint": {
          "type": "string"
        },
        "jsonpath": {
          "type": "string"
        },
        "max": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "points": {
          "type": "integer"
        },
        "resource": {
          "type": "string"
        },
        "type": {
          "enum": [
            "resourceExists",
            "podReady",
            "command",
            "jsonpath",
            "count",
            "http"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ValidationConfig": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "type": "array"
        },
        "passPercent": {
          "type": "integer"
        },
        "script": {
          "$ref": "#/$defs/ResourceItem"
        },
        "scripts": {
          "items": {
            "$ref": "#/$defs/ResourceItem"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
