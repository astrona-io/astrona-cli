        "kubeProxyMode": {
          "enum": [
            "iptables",
            "ipvs",
            "nftables",
            "none"
          ],
          "type": "string"
        },
        "podSubnet": {
          "type": "string"
        },
        "serviceSubnet": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "KindNodes": {
