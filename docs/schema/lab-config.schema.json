    "RuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/KindConfig"
        },
        "networks": {
          "items": {
            "$ref": "#/$defs/QEMUNetworkDef"
          },
          "type": "array"
        },
        "portForwards": {
          "items": {
            "$ref": "#/$defs/PortForward"
          },
          "type": "array"
        },
        "qemu": {
          "items": {
            "$ref": "#/$defs/QEMUVM"
          },
          "type": "array"
