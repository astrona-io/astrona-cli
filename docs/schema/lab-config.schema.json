    "LabConfig": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "$ref": "#/$defs/BootstrapConfig"
        },
        "exam": {
          "$ref": "#/$defs/ExamConfig"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataConfig"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeConfig"
        },
        "teardown": {
          "$ref": "#/$defs/TeardownConfig"
        },
        "testing": {
          "$ref": "#/$defs/BootstrapConfig"
        },
        "validation": {
          "$ref": "#/$defs/ValidationConfig"
        }
      },
      "type": "object"
    },
