          "items": {
            "$ref": "#/$defs/QEMUNetwork"
          },
          "type": "array"
        },
        "sshAccess": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sshPasswordAuth": {
          "type": "boolean"
