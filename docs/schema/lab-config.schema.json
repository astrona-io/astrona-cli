        "sshPort": {
          "type": "integer"
        },
        "validation": {
          "$ref": "#/$defs/ValidationConfig"
        }
      },
      "type": "object"
    },
    "ResourceItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
