            "calico"
          ],
          "type": "string"
        },
        "gatewayAPI": {
          "enum": [
            "envoy"
          ],
          "type": "string"
        },
        "gatewayPorts": {
          "$ref": "#/$defs/GatewayPorts"
        },
        "metricsServer": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "KindConfig": {
      "additionalProperties": false,
      "properties": {
        "addons": {
          "$ref": "#/$defs/KindAddons"
        },
        "featureGates": {
          "additionalProperties": {
            "type": "boolean"
          },
          "type": "object"
        },
        "image": {
          "type": "string"
        },
        "labs": {
          "items": {
            "$ref": "#/$defs/KindLab"
          },
          "type": "array"
        },
        "networking": {
          "$ref": "#/$defs/KindNetworking"
        },
        "nodes": {
          "$ref": "#/$defs/KindNodes"
        },
        "preloadImages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtimeConfig": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
