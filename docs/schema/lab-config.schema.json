        "hint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "points": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "type": {
          "enum": [
            "file",
            "folder",
            "url"
          ],
          "type": "string"
        }
      },
      "type": "object"
